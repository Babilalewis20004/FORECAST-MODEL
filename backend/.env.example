# Points at a native Postgres install on the host (not a Docker-managed
# container/volume -- see docker-compose.yml's comment on the backend
# service for why). Before first use, create the role and database:
#   CREATE ROLE predict WITH LOGIN PASSWORD 'predict';
#   CREATE DATABASE predict_model OWNER predict;
DATABASE_URL=postgresql+psycopg2://predict:predict@localhost:5432/predict_model
API_FOOTBALL_KEY=your-key-here
CORS_ORIGINS=http://localhost:5173
# Optional -- only needed for the "Share to Telegram" button. Create a bot
# via @BotFather in Telegram (free, a few messages) for the token; get the
# numeric chat/channel ID by messaging the bot then GET
# https://api.telegram.org/bot<token>/getUpdates, or by adding the bot as a
# channel admin.
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
